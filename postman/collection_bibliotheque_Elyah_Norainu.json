                      "pm.test('Paiement confirmé - HTTP 200', () => pm.response.to.have.status(200));",
                      "pm.test('Paiement payé', () => pm.expect(res.data.payment_status).to.eql('paid'));",
                      "pm.test('Abonnement Premium activé', () => pm.expect(res.data.subscription_status).to.eql('premium'));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "GET — Consulter le statut Premium",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  }
                ],
                "url": "{{base_url}}/subscriptions/status",
                "description": "Consulte le statut de l'abonnement et l'historique des paiements."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
