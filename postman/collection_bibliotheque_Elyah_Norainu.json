    {
      "name": "Authentification",
      "item": [
        {
          "name": "Login — succès",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Authentifie le compte de démonstration et enregistre automatiquement le JWT dans {{token}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let res = pm.response.json();",
                  "pm.test('Login réussi - HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('success vaut true et token présent', () => { pm.expect(res.success).to.be.true; pm.expect(res.data.token).to.be.a('string').and.not.empty; });",
                  "if (res.success && res.data.token) pm.environment.set('token', res.data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login — identifiants incorrects",
          "request": {
            "method": "POST",
            "header": [
              {
