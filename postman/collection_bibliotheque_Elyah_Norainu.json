                      "const res = pm.response.json();",
                      "pm.test('Statut récupéré - HTTP 200', () => pm.response.to.have.status(200));",
                      "pm.test('Abonnement Premium', () => pm.expect(res.data.subscription_status).to.eql('premium'));",
                      "pm.test('Historique des paiements présent', () => pm.expect(res.data.payments).to.be.an('array'));"
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
