                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let res = pm.response.json();",
                  "pm.test('Identifiants refusés - HTTP 401', () => pm.response.to.have.status(401));",
                  "pm.test('success vaut false', () => pm.expect(res.success).to.be.false);"
                ]
              }
            }
          ]
        }
